# Скопируйте в .env и задайте свои значения
# cp .env.example .env

SECRET_KEY=your-secret-key
JWT_SECRET_KEY=your-jwt-secret-key
# Мобильный API: POST /api/v1/auth/login, GET /api/v1/auth/me (Bearer access)
# API_ALLOW_UNASSIGNED_POOL=true
# API_CLOSE_REQUIRES_COMPLETED_MODE=true
# API_CLOSE_MIN_PHOTOS=1
# API_CLOSE_REQUIRES_CHECKLIST=true
# API_FORCE_HTTPS=false
SQLALCHEMY_DATABASE_URI=postgresql://user:password@localhost:5432/utilbase
BOT_TOKEN=your-telegram-bot-token
# Через запятую: telegram user id для команд /stats и /channels
TELEGRAM_ADMIN_IDS=
BASE_DIR=
# Лимит загрузки JSON при импорте чата через браузер (МБ). Для огромных result.json используйте путь к файлу на диске.
MAX_CONTENT_LENGTH_MB=512
# Ограничение обзора папок при импорте (через запятую корни). Пусто = без ограничения (только для доверенной сети).
# IMPORT_BROWSER_ROOTS=V:\,D:\Exports
YANDEX_API_KEY=your-yandex-api-key
